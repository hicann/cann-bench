# Copy this file to .env. The top-level name is the value passed to --agent.
codex:
  harness: codex
  api_key: replace-with-your-openai-api-key
  base_url: https://api.openai.com/v1
  model: gpt-5.4
  model_reasoning_effort: high

claude-code:
  harness: claude-code
  auth_type: api-key # Use bearer for Authorization: Bearer gateways.
  api_key: replace-with-your-anthropic-api-key
  base_url: https://api.anthropic.com
  model: sonnet
  model_reasoning_effort: high
