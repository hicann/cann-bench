{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CANNBench suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "status", "source_revision", "members", "assets", "scoring"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_by": {"const": "migrate_task_catalog"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
    "version": {"type": "string", "minLength": 1},
    "status": {"enum": ["published", "archived", "experimental", "example", "draft"]},
    "source_revision": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40}$"},
    "members": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["task", "version"],
        "properties": {
          "task": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
          "version": {"type": "string", "minLength": 1},
          "weight": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    },
    "assets": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "scoring": {"type": ["string", "null"]}
  }
}
